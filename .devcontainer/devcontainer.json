{
  "name": "Minimal Jekyll Theme",
  "image": "mcr.microsoft.com/devcontainers/ruby:1-3.1-bullseye",
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": {
      "label": "Jekyll preview",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash script/bootstrap",
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "[ruby]": {
          "editor tabSize": 2,
          "editor.insertSpaces": true
        },
        "[yaml]": {
          "editor tabSize": 2,
          "editor.insertSpaces": true
        }
      }
    }
  }
}
